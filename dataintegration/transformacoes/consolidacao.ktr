    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>proprietario_id</leftvalue>
        <function>&lt;></function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>SEM</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
